<%- include('partials/header', { title: profileUser.display_name || profileUser.username }) %>

<div class="profile-page">
  <div class="profile-card">
    <div class="profile-header">
      <div class="profile-avatar-large">
        <%= (profileUser.display_name || profileUser.username).charAt(0).toUpperCase() %>
      </div>
      <div>
        <h1><%= profileUser.display_name || profileUser.username %></h1>
        <p class="profile-username">@<%= profileUser.username %></p>
        <p class="profile-id">ID: <code><%= profileUser.id %></code></p>
      </div>
    </div>
    <% if (profileUser.bio) { %>
      <div class="profile-bio">
        <p><%= profileUser.bio %></p>
      </div>
    <% } %>
    <div class="profile-meta">
      <p>Member since: <%= profileUser.created_at %></p>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
